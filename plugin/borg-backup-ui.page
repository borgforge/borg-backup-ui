    <script>
    function bbui_apply_config(action) {
      var form = document.getElementById('bbui-config-form');
      var buttons = document.getElementById('bbui-config-btns');
      var portInput = form.querySelector('input[name="PORT"]');
      var bindInput = form.querySelector('select[name="BIND"]');
      var defaultButtons = buttons.innerHTML;
      var requestedPort = action === 'default' ? '8765' : (portInput.value || '8765');
      var parsedPort = parseInt(requestedPort, 10);
      if (!parsedPort || parsedPort < 1 || parsedPort > 65535) {
        requestedPort = '8765';
      } else {
        requestedPort = String(parsedPort);
      }
      var requestedBind = action === 'default' ? '0.0.0.0' : (bindInput.value || '0.0.0.0');
      var target = 'http://' + window.location.hostname + ':' + requestedPort + '/';
      var targetWindow = window.open('about:blank', '_blank');
      if (targetWindow) {
        targetWindow.document.write('<!doctype html><title>Borg Backup UI</title><p style="font-family:sans-serif">Borg Backup UI is restarting...</p>');
        targetWindow.document.close();
      }
      var params = new URLSearchParams();
      params.set('action', action);
      params.set('PORT', requestedPort);
      params.set('BIND', requestedBind);
      params.set('bbui_async', '1');
      params.set('_', String(Date.now()));
      if (action === 'default') {
        portInput.value = '8765';
        bindInput.value = '0.0.0.0';
      }
      buttons.innerHTML = '<span style="color:#888;font-size:13px">&#8987; Applying configuration...</span>';
      fetch('?' + params.toString(), {credentials: 'same-origin', cache: 'no-store'}).catch(function(){});
      setTimeout(function() {
        buttons.innerHTML = '<span style="color:#888;font-size:13px">&#8987; Restarting service...</span>';
      }, 800);
      setTimeout(function() {
        if (targetWindow && !targetWindow.closed) {
          targetWindow.location.href = target;
        } else {
          buttons.innerHTML = defaultButtons + '<span style="color:#888;font-size:13px"> Use the Open Borg Backup UI button above if no new window opened.</span>';
          return;
        }
        buttons.innerHTML = defaultButtons;
      }, 3500);
      return false;
    }
    </script>
  </div>
</div>

