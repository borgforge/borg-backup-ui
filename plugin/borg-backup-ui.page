<?PHP
$PLUGIN_DIR = "/boot/config/plugins/borg-backup-ui";
$CONF_FILE  = "$PLUGIN_DIR/borg_backup_ui.conf";
$PIDFILE    = "/var/run/borg_backup_ui.pid";
$RC         = "/etc/rc.d/rc.borg_backup_ui";

function bbui_is_running($pidfile) {
  if (!file_exists($pidfile)) return false;
  $pid = trim(file_get_contents($pidfile));
  return $pid && file_exists("/proc/$pid");
}

function bbui_read_conf($file) {
  $conf = ['PORT' => '8765', 'BIND' => '0.0.0.0'];
  if (!file_exists($file)) return $conf;
  foreach (file($file, FILE_IGNORE_NEW_LINES) as $line) {
    $line = trim($line);
    if ($line === '' || $line[0] === '#') continue;
    if (preg_match('/^([A-Z_]+)=(.*)$/', $line, $m)) $conf[$m[1]] = $m[2];
  }
  return $conf;
}

function bbui_write_conf($file, $port, $bind) {
  if (!file_exists($file)) {
    file_put_contents($file, "PORT=$port\nBIND=$bind\n");
    return;
  }
  $lines = file($file, FILE_IGNORE_NEW_LINES);
  $port_set = $bind_set = false;
  foreach ($lines as &$line) {
    if (preg_match('/^PORT=/', $line)) { $line = "PORT=$port"; $port_set = true; }
    if (preg_match('/^BIND=/', $line)) { $line = "BIND=$bind"; $bind_set = true; }
  }
  if (!$port_set) $lines[] = "PORT=$port";
  if (!$bind_set) $lines[] = "BIND=$bind";
  file_put_contents($file, implode("\n", $lines) . "\n");
}

function bbui_request_value($key, $default = '') {
  static $raw_post = null;
  if (isset($_POST[$key])) return $_POST[$key];
  if (isset($_GET[$key])) return $_GET[$key];
  if ($raw_post === null) {
    $raw_post = [];
    $raw = file_get_contents('php://input');
    if (is_string($raw) && $raw !== '') {
      parse_str($raw, $raw_post);
    }
  }
  return $raw_post[$key] ?? $default;
}

function bbui_ui_url($port) {
  $host = $_SERVER['SERVER_ADDR'] ?? ($_SERVER['HTTP_HOST'] ?? '127.0.0.1');
  $host = preg_replace('/:\d+$/', '', (string)$host);
  return "http://$host:$port/";
}

function bbui_python_runtime_status() {
  $path = trim((string)shell_exec("command -v python3 2>/dev/null"));
  $status = [
    'ok' => false,
    'path' => $path,
    'version' => '',
    'reason' => '',
    'min_version' => '3.10',
  ];
  if ($path === '') {
    $status['reason'] = 'Python 3 was not found.';
    return $status;
  }
  if (!is_executable($path)) {
    $status['reason'] = "python3 is not executable: $path";
    return $status;
  }
  $cmd = escapeshellarg($path) . " -c " . escapeshellarg("import sys; print('.'.join(map(str, sys.version_info[:3]))); raise SystemExit(0 if sys.version_info >= (3, 10) else 1)") . " 2>/dev/null";
  $lines = [];
  $rc = 1;
  exec($cmd, $lines, $rc);
  $version = trim((string)($lines[0] ?? ''));
  $status['version'] = $version;
  if ($version === '') {
    $status['reason'] = "The Python version could not be determined.";
    return $status;
  }
  if ($rc !== 0) {
    $status['reason'] = "Python $version is too old. Python 3.10 or newer is required.";
    return $status;
  }
  $status['ok'] = true;
  return $status;
}

function bbui_run_admin_helper($plugin_dir, $python_path, $args, $payload = null) {
  $script = "$plugin_dir/api/admin_recovery.py";
  if (!is_file($script)) {
    return ['ok' => false, 'error' => 'Admin recovery helper is missing. Reinstall or update the plugin package.'];
  }
  if ($python_path === '' || !is_executable($python_path)) {
    return ['ok' => false, 'error' => 'Python 3 is not available. Install or update Python 3 for Unraid first.'];
  }

  $cmd = escapeshellarg($python_path) . ' ' . escapeshellarg($script);
  foreach ($args as $arg) {
    $cmd .= ' ' . escapeshellarg($arg);
  }
  $descriptors = [
    0 => ['pipe', 'r'],
    1 => ['pipe', 'w'],
    2 => ['pipe', 'w'],
  ];
  $env = $_ENV;
  $env['BBUI_PLUGIN_DIR'] = $plugin_dir;
  $process = proc_open($cmd, $descriptors, $pipes, null, $env);
  if (!is_resource($process)) {
    return ['ok' => false, 'error' => 'Admin recovery could not be started.'];
  }

  if ($payload !== null) {
    fwrite($pipes[0], json_encode($payload));
  }
  fclose($pipes[0]);
  $stdout = stream_get_contents($pipes[1]);
  fclose($pipes[1]);
  stream_get_contents($pipes[2]);
  fclose($pipes[2]);
  $rc = proc_close($process);
  $result = json_decode($stdout, true);
  if (!is_array($result)) {
    return ['ok' => false, 'error' => 'Admin recovery returned an invalid response.'];
  }
  if ($rc !== 0 || empty($result['ok'])) {
    return ['ok' => false, 'error' => (string)($result['error'] ?? 'Admin recovery failed.')];
  }
  return $result;
}

function bbui_load_admin_accounts($plugin_dir, $python_path) {
  $result = bbui_run_admin_helper($plugin_dir, $python_path, ['--list-admins']);
  if (empty($result['ok']) || !isset($result['admins']) || !is_array($result['admins'])) {
    return [];
  }
  return $result['admins'];
}

function bbui_create_admin_recovery_link($plugin_dir, $python_path, $username, $port) {
  $result = bbui_run_admin_helper(
    $plugin_dir,
    $python_path,
    ['--create-token'],
    ['username' => $username]
  );
  if (empty($result['ok']) || empty($result['token'])) {
    return $result;
  }
  $base = rtrim(bbui_ui_url($port), '/');
  $result['url'] = $base . '/admin-recovery?token=' . rawurlencode((string)$result['token']);
  unset($result['token']);
  return $result;
}

// Version from .plg file
$version = '';
$plugin_manifests = [
  "/boot/config/plugins/borg-backup-ui-test.plg",
  "/boot/config/plugins/borg-backup-ui.plg",
];
foreach ($plugin_manifests as $plg) {
  if (!file_exists($plg)) continue;
  $plg_content = file_get_contents($plg);
  if (preg_match('/<!ENTITY version\s+"([^"]+)"/', $plg_content, $m)) {
    $version = $m[1];
    break;
  }
}

// Actions use a GET parameter because Unraid intercepts form POSTs and opens a new window.
// Do not sleep here; JavaScript shows the loading state and reloads after a delay.
$action = (string)bbui_request_value('action', '');
$python_status = bbui_python_runtime_status();
$python_ok = $python_status['ok'];
$warn_msg = '';
$async = (($_POST['bbui_async'] ?? '') === '1' || ($_GET['bbui_async'] ?? '') === '1');
$json_response = null;
$admin_recovery_result = null;

if (($action === 'start' || $action === 'restart') && !$python_ok) {
  $warn_msg = $python_status['reason'] . " Install or update the 'Python 3 for Unraid' plugin first.";
} elseif ($action === 'start') {
  shell_exec("$RC start >/dev/null 2>&1 &");
} elseif ($action === 'stop') {
  shell_exec("$RC stop >/dev/null 2>&1 &");
} elseif ($action === 'restart') {
  shell_exec("$RC restart >/dev/null 2>&1 &");
} elseif ($action === 'apply' || $action === 'default') {
  if ($action === 'default') {
    $port = '8765'; $bind = '0.0.0.0';
  } else {
    $port = intval($_POST['PORT'] ?? ($_GET['PORT'] ?? 8765));
    $requested_bind = $_POST['BIND'] ?? ($_GET['BIND'] ?? '');
    $bind = in_array($requested_bind, ['0.0.0.0', '127.0.0.1']) ? $requested_bind : '0.0.0.0';
    if ($port < 1 || $port > 65535) $port = 8765;
  }
  bbui_write_conf($CONF_FILE, $port, $bind);
  shell_exec("$RC restart >/dev/null 2>&1 &");
  $json_response = [
    'ok' => true,
    'action' => $action,
    'port' => $port,
    'bind' => $bind,
    'url' => bbui_ui_url($port),
  ];
} elseif ($action === 'admin_recovery_start') {
  $username = trim((string)bbui_request_value('username', ''));
  if (!$python_ok) {
    $admin_recovery_result = ['ok' => false, 'error' => $python_status['reason'] . " Install or update the 'Python 3 for Unraid' plugin first."];
  } else {
    $current_conf = bbui_read_conf($CONF_FILE);
    $admin_recovery_result = bbui_create_admin_recovery_link($PLUGIN_DIR, $python_status['path'], $username, $current_conf['PORT']);
  }
  if ($async) {
    $json_response = $admin_recovery_result;
  }
}

if ($async) {
  header('Content-Type: application/json');
  echo json_encode($json_response ?? ['ok' => false, 'error' => 'Unsupported control page action.']);
  exit;
}

$running = bbui_is_running($PIDFILE);
$conf    = bbui_read_conf($CONF_FILE);
$port    = $conf['PORT'];
$bind    = $conf['BIND'];
$ui_url  = bbui_ui_url($port);
$admin_accounts = $python_ok ? bbui_load_admin_accounts($PLUGIN_DIR, $python_status['path']) : [];
?>
