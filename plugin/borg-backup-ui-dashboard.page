<script>
(function(){
  const root = document.getElementById('bbui-widget');
  if (!root) return;
  const endpoint = root.getAttribute('data-endpoint');
  const tile = root.closest('tbody') || document;
  const body = tile.querySelector('[data-bbui-body]');
  const refreshButton = tile.querySelector('[data-bbui-refresh]');
  const collapseButton = tile.querySelector('[data-bbui-collapse]');
  const fields = {};
  tile.querySelectorAll('.bbui-tile-title [data-bbui], #bbui-widget [data-bbui]').forEach((node) => fields[node.getAttribute('data-bbui')] = node);
  const latestState = root.querySelector('[data-bbui-latest-state]');
  const latestPill = root.querySelector('[data-bbui-latest-pill]');
  const overallDot = root.querySelector('[data-bbui-overall-dot]');

  function get(data, path, fallback) {
    return path.split('.').reduce((value, part) => value && Object.prototype.hasOwnProperty.call(value, part) ? value[part] : undefined, data) ?? fallback;
  }
  function intValue(data, path) {
    const value = parseInt(get(data, path, 0), 10);
    return Number.isFinite(value) && value > 0 ? value : 0;
  }
  function stateClass(value) {
    value = String(value || '').toLowerCase();
    if (['ok','healthy','success'].includes(value)) return 'ok';
    if (['warning','attention'].includes(value)) return 'warn';
    if (['error','critical','failed'].includes(value)) return 'err';
    if (['running','active'].includes(value)) return 'run';
    return 'neutral';
  }
  function statusLabel(value) {
    const state = stateClass(value);
    if (state === 'ok') return 'OK';
    if (state === 'warn') return 'Warning';
    if (state === 'err') return 'Failed';
    if (state === 'run') return 'Running';
    if (value === 'skipped') return 'Skipped';
    return '-';
  }
  function latestIcon(value) {
    const state = stateClass(value);
    if (state === 'ok') return 'fa-check-circle-o';
    if (state === 'warn') return 'fa-exclamation-triangle';
    if (state === 'err') return 'fa-times-circle-o';
    if (state === 'run') return 'fa-play-circle-o';
    if (value === 'skipped') return 'fa-forward';
    return 'fa-minus';
  }
  /** Format a timestamp for display, optionally including seconds for fetch feedback. */
  function formatTime(value, seconds = false) {
    if (!value) return 'never updated';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);
    return date.toLocaleString('en-US', {month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit', ...(seconds ? {second:'2-digit'} : {})});
  }
  function parseDateValue(value) {
    const raw = String(value || '').trim();
    if (!raw) return null;
    const normalized = raw.includes('T') ? raw : raw.replace(' ', 'T');
    const date = new Date(normalized);
    return Number.isNaN(date.getTime()) ? null : date;
  }
  function isPast(value, now) {
    const date = parseDateValue(value);
    return !!date && date.getTime() <= now.getTime();
  }
  function adjustedJobCounts(data, now) {
    const items = Array.isArray(get(data, 'jobs.items', [])) ? get(data, 'jobs.items', []) : [];
    if (!items.length) {
      return {
        total: intValue(data, 'jobs.enabled'),
        successful: intValue(data, 'jobs.successful'),
        warnings: intValue(data, 'jobs.warnings'),
        skipped: intValue(data, 'jobs.skipped'),
        failed: intValue(data, 'jobs.failed'),
        running: intValue(data, 'jobs.running')
      };
    }
    const counts = {total: 0, successful: 0, warnings: 0, skipped: 0, failed: 0, running: 0};
    items.forEach((item) => {
      if (!item || item.enabled === false) return;
      counts.total += 1;
      if (item.running) {
        counts.running += 1;
        return;
      }
      const status = String(item.last_status || '').toLowerCase();
      const overdue = !!item.backup_overdue || isPast(item.backup_overdue_after, now);
      if (status === 'skipped') counts.skipped += 1;
      if (status === 'error' || status === 'failed' || status === 'failure') {
        counts.failed += 1;
      } else if (overdue || ['warning','cancelled'].includes(status)) {
        counts.warnings += 1;
      } else if (status === 'success') {
        counts.successful += 1;
      }
    });
    return counts;
  }
  function adjustedRestoreProof(data, now) {
    const items = Array.isArray(get(data, 'jobs.items', [])) ? get(data, 'jobs.items', []) : [];
    if (!items.length) {
      return {
        configured: intValue(data, 'restore_proof.configured'),
        verified: intValue(data, 'restore_proof.verified'),
        failed: intValue(data, 'restore_proof.failed'),
        overdue: intValue(data, 'restore_proof.overdue'),
        open: intValue(data, 'restore_proof.open')
      };
    }
    const proof = {configured: 0, verified: 0, failed: 0, overdue: 0, open: 0};
    items.forEach((item) => {
      if (!item || item.enabled === false) return;
      const status = String(item.restore_verification_status || 'never').toLowerCase();
      if (status === 'not_required') return;
      proof.configured += 1;
      if (status === 'verified') proof.verified += 1;
      else if (status === 'failed') proof.failed += 1;
      else if (status === 'never' || status === '') proof.open += 1;
      if (status === 'stale' || !!item.restore_verification_is_overdue || isPast(item.restore_verification_valid_until, now)) {
        proof.overdue += 1;
      }
    });
    return proof;
  }
  function jobStatusEvidence(data) {
    const items = Array.isArray(get(data, 'jobs.items', [])) ? get(data, 'jobs.items', []) : [];
    return items.some((item) => item && item.enabled !== false && (String(item.last_status || '').trim() || String(item.last_timestamp || '').trim()));
  }
  function overallStateFromCounts(counts, restore, cacheState, hasEvidence) {
    if (counts.failed || restore.failed) return 'error';
    if (counts.warnings || restore.overdue) return 'warning';
    if (counts.running) return 'running';
    if (cacheState !== 'fresh' || (counts.total && !hasEvidence)) return 'unknown';
    if (!counts.total) return 'unknown';
    return 'ok';
  }
  function setText(name, value) {
    if (fields[name]) fields[name].textContent = String(value);
  }
  function setIcon(name, iconClass) {
    if (fields[name]) fields[name].innerHTML = '<i class="fa ' + iconClass + '"></i>';
  }
  function setLatestClass(cls) {
    ['ok','warn','err','run','neutral'].forEach((name) => {
      latestState && latestState.classList.remove(name);
      latestPill && latestPill.classList.remove(name);
    });
    latestState && latestState.classList.add(cls);
    latestPill && latestPill.classList.add(cls);
  }
  function setOverallClass(cls) {
    ['ok','warn','err','run','neutral'].forEach((name) => overallDot && overallDot.classList.remove(name));
    overallDot && overallDot.classList.add(cls);
  }
  let lastData = null;
  let fetchError = '';
  let inFlight = false;

  /** Format age from an absolute timestamp; never reuse a cached relative label.
   * @param {Object} latest Cached latest-backup metadata; may lack a timestamp.
   * @param {Date} now Browser clock used for the age calculation.
   * @returns {string} Age and duration, or a hint when time evidence is missing.
   */
  function latestDetailAt(latest, now) {
    if (!latest || !latest.name) return 'No backup status yet';
    const date = parseDateValue(latest.timestamp);
    const duration = latest && latest.duration ? 'Duration ' + latest.duration : '';
    if (!date) return duration || 'Time details pending next backup update';
    const minutes = Math.max(0, Math.floor((now - date) / 60000));
    const age = date > now ? formatTime(date) : minutes < 1 ? 'just now' :
      minutes < 60 ? minutes + 'm ago' : minutes < 1440 ? Math.floor(minutes / 60) + 'h ago' : Math.floor(minutes / 1440) + 'd ago';
    return [age, duration].filter(Boolean).join(' - ');
  }

  /** Render cached schedule instants in browser local time, including date changes.
   * @param {string} value Offset-aware scheduled timestamp from the cache.
   * @param {Date} now Browser clock used for calendar comparisons.
   * @returns {string} Upcoming date label, elapsed-time label, or missing-data hint.
   */
  function scheduleLabel(value, now) {
    const date = parseDateValue(value);
    if (!date) return 'Schedule pending next update';
    if (date <= now) return 'Scheduled ' + formatTime(date) + ' (past)';
    const tomorrow = new Date(now);
    tomorrow.setDate(tomorrow.getDate() + 1);
    const day = date.toDateString() === now.toDateString() ? 'Today ' :
      date.toDateString() === tomorrow.toDateString() ? 'Tomorrow ' : date.toLocaleDateString('en-GB') + ' ';
    return day + date.toLocaleTimeString('en-GB', {hour: '2-digit', minute: '2-digit'});
  }

  /** Reject malformed snapshots before replacing the last successfully rendered data.
   * @param {*} data Parsed endpoint response or embedded initial cache.
   * @returns {boolean} Whether the core cache fields support rendering.
   */
  function validSnapshot(data) {
    return !!data && data.schema_version === 1 && ['fresh', 'initial'].includes(data.cache_state) &&
      !!parseDateValue(data.generated_at) && !!data.jobs && !!data.latest_backup &&
      typeof data.latest_backup === 'object' && !Array.isArray(data.latest_backup) &&
      ['enabled', 'successful', 'warnings', 'failed', 'running'].every((key) =>
        Number.isFinite(data.jobs[key]) && data.jobs[key] >= 0);
  }

  /** Select a palette from the actual Unraid background, independent of OS theme. */
  function syncTheme() {
    const ancestors = [];
    for (let node = root.parentElement; node; node = node.parentElement) ancestors.unshift(node);
    let background = [255, 255, 255];
    ancestors.forEach((node) => {
      const match = window.getComputedStyle(node).backgroundColor.match(/rgba?\(([^)]+)\)/);
      if (!match) return;
      const values = match[1].split(/[, /]+/).map(Number);
      const alpha = values.length > 3 ? values[3] : 1;
      background = background.map((old, index) => old * (1 - alpha) + values[index] * alpha);
    });
    const light = background[0] * .2126 + background[1] * .7152 + background[2] * .0722 > 140;
    tile.setAttribute('data-bbui-theme', light ? 'light' : 'dark');
  }

  function render(data) {
    const now = new Date();
    const counts = adjustedJobCounts(data, now);
    const restore = adjustedRestoreProof(data, now);
    const total = counts.total;
    const repoOnline = intValue(data, 'repositories.online');
    const repoTotal = intValue(data, 'repositories.total');
    const latestStatus = get(data, 'latest_backup.status', 'unknown');
    const latestCls = stateClass(latestStatus);
    const configured = restore.configured;
    const cacheState = String(get(data, 'cache_state', 'missing')).toLowerCase();
    const hasEvidence = jobStatusEvidence(data);
    const overallState = overallStateFromCounts(counts, restore, cacheState, hasEvidence);
    const overallCls = stateClass(overallState);
    const cacheNote = fetchError || (cacheState === 'initial' ? 'Initial status' : '');
    let latestName = String(get(data, 'latest_backup.name', '') || '').trim();
    let latestDetail = latestDetailAt(data.latest_backup, now);
    if (!latestName) latestName = 'No status yet';
    if (!latestDetail) latestDetail = 'Cached status updates after backup or restore-test activity.';

    setText('job_total', total);
    setText('job_label', total === 1 ? 'backup job' : 'backup jobs');
    setText('cache_note', cacheNote);
    setText('success', counts.successful);
    setText('warnings', counts.warnings);
    setText('skipped', counts.skipped);
    setText('failed', counts.failed);
    setText('running', counts.running);
    setText('repos', repoOnline + '/' + repoTotal);
    setIcon('latest_icon', latestIcon(latestStatus));
    setText('latest_name', latestName);
    setText('latest_detail', latestDetail);
    setText('latest_label', statusLabel(latestStatus));
    setText('restore_label', configured < 1 ? 'not planned' : restore.verified + '/' + configured + ' verified');
    setText('restore_detail', restore.overdue + ' overdue - ' + restore.failed + ' failed - ' + restore.open + ' open');
    setText('overall_label', statusLabel(overallState));
    setText('generated', formatTime(get(data, 'generated_at', '')));
    setLatestClass(latestCls);
    setOverallClass(overallCls);

    const nextRows = Array.isArray(data.next_backups) ? data.next_backups.slice(0, 2) : [];
    if (fields.next_rows) {
      fields.next_rows.textContent = '';
      if (!nextRows.length) {
        const row = document.createElement('div');
        row.innerHTML = '<span>No scheduled backups</span><b>-</b>';
        fields.next_rows.appendChild(row);
      } else {
        nextRows.forEach((item) => {
          const row = document.createElement('div');
          const name = document.createElement('span');
          const time = document.createElement('b');
          name.textContent = item && item.name ? item.name : 'Backup';
          time.textContent = scheduleLabel(item && item.scheduled_at, now);
          row.appendChild(name);
          row.appendChild(time);
          fields.next_rows.appendChild(row);
        });
      }
    }
  }
  /** Fetch only the flash cache; preserve evidence on HTTP, JSON or schema errors. */
  async function update() {
    if (inFlight) return;
    inFlight = true;
    refreshButton && refreshButton.setAttribute('aria-busy', 'true');
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 10000);
    try {
      const response = await fetch(endpoint + '?_=' + Date.now(), {cache: 'no-store', signal: controller.signal});
      if (!response.ok) throw new Error('unavailable');
      const data = await response.json();
      if (!validSnapshot(data)) throw new Error('invalid');
      lastData = data;
      fetchError = '';
      setText('fetched', formatTime(new Date(), true));
      render(data);
    } catch (error) {
      const detail = lastData ? 'Showing last available data.' : 'No cached status available.';
      fetchError = (error.message === 'invalid' || error instanceof SyntaxError ?
        'Invalid status cache. ' : 'Status cache is not reachable. ') + detail;
      setText('cache_note', fetchError);
    } finally {
      window.clearTimeout(timeout);
      inFlight = false;
      refreshButton && refreshButton.setAttribute('aria-busy', 'false');
    }
  }
  syncTheme();
  try {
    const initial = JSON.parse(document.getElementById('bbui-widget-initial').textContent || '{}');
    if (validSnapshot(initial)) {
      lastData = initial;
      render(initial);
    }
  } catch (_error) {}
  refreshButton && refreshButton.addEventListener('click', function(event) {
    event.preventDefault();
    update();
  });
  collapseButton && collapseButton.addEventListener('click', function(event) {
    event.preventDefault();
    if (!body) return;
    const hidden = body.style.display === 'none';
    body.style.display = hidden ? '' : 'none';
    collapseButton.setAttribute('aria-expanded', String(hidden));
    collapseButton.setAttribute('aria-label', hidden ? 'Collapse' : 'Expand');
    collapseButton.title = hidden ? 'Collapse' : 'Expand';
    const icon = collapseButton.querySelector('i');
    if (icon) {
      icon.className = hidden ? 'fa fa-chevron-up' : 'fa fa-chevron-down';
    }
  });
  window.setInterval(function() {
    syncTheme();
    if (lastData) render(lastData);
    update();
  }, 15000);
  update();
})();
</script>
</td></tr>
</tbody>
EOT;
?>
