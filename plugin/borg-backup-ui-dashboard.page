Menu="Dashboard:0"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.11.9','>')"
---
<?PHP
$pluginname = "borg-backup-ui";
$plugin_dir = "/boot/config/plugins/borg-backup-ui";
$cache_file = "$plugin_dir/widget-status.json";
$conf_file = "$plugin_dir/borg_backup_ui.conf";

function bbui_dash_h($value) {
  return htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

function bbui_dash_read_conf($file) {
  $conf = ['PORT' => '8765'];
  if (!file_exists($file)) return $conf;
  foreach (file($file, FILE_IGNORE_NEW_LINES) as $line) {
    $line = trim($line);
    if ($line === '' || $line[0] === '#') continue;
    if (preg_match('/^([A-Z_]+)=(.*)$/', $line, $m)) $conf[$m[1]] = $m[2];
  }
  return $conf;
}

function bbui_dash_ui_url($port) {
  $host = $_SERVER['SERVER_ADDR'] ?? ($_SERVER['HTTP_HOST'] ?? '127.0.0.1');
  $host = preg_replace('/:\d+$/', '', (string)$host);
  return "http://$host:$port/";
}

function bbui_dash_value($data, $path, $default = '') {
  $current = $data;
  foreach (explode('.', $path) as $part) {
    if (!is_array($current) || !array_key_exists($part, $current)) return $default;
    $current = $current[$part];
  }
  return $current;
}

function bbui_dash_int($data, $path) {
  return max(0, intval(bbui_dash_value($data, $path, 0)));
}

function bbui_dash_state_class($state) {
  $state = strtolower((string)$state);
  if (in_array($state, ['ok', 'healthy', 'success'], true)) return 'ok';
  if (in_array($state, ['warning', 'attention'], true)) return 'warn';
  if (in_array($state, ['error', 'critical', 'failed'], true)) return 'err';
  if (in_array($state, ['running', 'active'], true)) return 'run';
  return 'neutral';
}

function bbui_dash_time($value) {
  $raw = trim((string)$value);
  if ($raw === '') return 'nie aktualisiert';
  $ts = strtotime($raw);
  if (!$ts) return $raw;
  return date('d.m. H:i', $ts);
}

function bbui_dash_status_label($state) {
  $state = bbui_dash_state_class($state);
  if ($state === 'ok') return 'OK';
  if ($state === 'warn') return 'Warnung';
  if ($state === 'err') return 'Fehler';
  if ($state === 'run') return 'Laeuft';
  return '-';
}

function bbui_dash_restore_label($data) {
  $configured = bbui_dash_int($data, 'restore_proof.configured');
  if ($configured < 1) return 'nicht geplant';
  return bbui_dash_int($data, 'restore_proof.verified') . '/' . $configured . ' verifiziert';
}

$conf = bbui_dash_read_conf($conf_file);
$ui_url = bbui_dash_ui_url($conf['PORT'] ?? '8765');
$data = [];
$cache_error = '';
if (is_file($cache_file)) {
  $raw = file_get_contents($cache_file);
  $decoded = json_decode($raw, true);
  if (is_array($decoded)) {
    $data = $decoded;
  } else {
    $cache_error = 'Statusdatei konnte nicht gelesen werden.';
  }
} else {
  $cache_error = 'Status wird nach dem naechsten Start von Borg Backup UI erstellt.';
}

$cache_state = strtolower((string)bbui_dash_value($data, 'cache_state', 'missing'));
$overall_state = bbui_dash_state_class(bbui_dash_value($data, 'status.state', 'neutral'));
$job_total = bbui_dash_int($data, 'jobs.enabled');
$job_label = $job_total === 1 ? 'Backup-Job' : 'Backup-Jobs';
$success = bbui_dash_int($data, 'jobs.successful');
$warnings = bbui_dash_int($data, 'jobs.warnings');
$failed = bbui_dash_int($data, 'jobs.failed');
$running = bbui_dash_int($data, 'jobs.running');
$repo_online = bbui_dash_int($data, 'repositories.online');
$repo_total = bbui_dash_int($data, 'repositories.total');
$latest_name = bbui_dash_value($data, 'latest_backup.name', 'Noch kein Status');
$latest_detail = bbui_dash_value($data, 'latest_backup.detail', 'Borg Backup UI wird den Status beim naechsten Abruf aktualisieren.');
if (trim((string)$latest_name) === '') $latest_name = 'Noch kein Status';
if (trim((string)$latest_detail) === '') $latest_detail = 'Status wird beim naechsten UI-Statusabruf aktualisiert.';
$latest_state = bbui_dash_state_class(bbui_dash_value($data, 'latest_backup.status', 'neutral'));
$latest_label = bbui_dash_status_label(bbui_dash_value($data, 'latest_backup.status', 'neutral'));
$restore_label = bbui_dash_restore_label($data);
$restore_overdue = bbui_dash_int($data, 'restore_proof.overdue');
$restore_failed = bbui_dash_int($data, 'restore_proof.failed');
$restore_open = bbui_dash_int($data, 'restore_proof.open');
$generated = bbui_dash_time(bbui_dash_value($data, 'generated_at', ''));
$latest_name_h = bbui_dash_h($latest_name);
$latest_detail_h = bbui_dash_h($latest_detail);
$latest_label_h = bbui_dash_h($latest_label);
$restore_label_h = bbui_dash_h($restore_label);
$overall_label_h = bbui_dash_h(bbui_dash_status_label(bbui_dash_value($data, 'status.state', 'neutral')));
$generated_h = bbui_dash_h($generated);
$initial_note = ($cache_state === 'initial' && !$cache_error)
  ? 'Noch keine Laufdaten geladen. Borg Backup UI aktualisiert die Kachel beim naechsten Statusabruf.'
  : '';

$latest_icon = $latest_state === 'ok' ? '&#10003;' : ($latest_state === 'warn' ? '!' : ($latest_state === 'err' ? '&times;' : ($latest_state === 'run' ? '&#9654;' : '-')));

$next_rows = '';
$next_backups = bbui_dash_value($data, 'next_backups', []);
if (is_array($next_backups) && count($next_backups)) {
  foreach (array_slice($next_backups, 0, 2) as $item) {
    if (!is_array($item)) continue;
    $next_rows .= '<div><span>' . bbui_dash_h($item['name'] ?? 'Backup') . '</span><b>' . bbui_dash_h($item['time'] ?? '') . '</b></div>';
  }
}
if ($next_rows === '') {
  $next_rows = '<div><span>Keine geplanten Backups</span><b>-</b></div>';
}

$cache_note_text = $cache_error ?: $initial_note;
$cache_note = $cache_note_text
  ? '<div class="bbui-widget-note">' . bbui_dash_h($cache_note_text) . '</div>'
  : '';

$mytiles[$pluginname]['column1'] =
<<<EOT
<tbody title="Borg Backup UI overview">
<tr><td>Borg Backup UI</td></tr>
<tr><td>
<style>
.bbui-widget{font-size:12px;line-height:1.3}
.bbui-widget a{text-decoration:none}
.bbui-widget-head{display:flex;align-items:center;gap:8px;margin-bottom:7px}
.bbui-widget-icon{width:28px;height:28px;border-radius:7px;object-fit:contain;flex:0 0 auto}
.bbui-widget-title{font-weight:800;font-size:14px}
.bbui-widget-sub{color:var(--gray-500,#8b98a7);font-size:12px}
.bbui-widget-actions{margin-left:auto;display:flex;gap:4px}
.bbui-widget-action{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border:1px solid rgba(148,163,184,.35);border-radius:7px;color:inherit;background:rgba(148,163,184,.10);font-weight:800}
.bbui-widget-strip{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;margin-bottom:7px}
.bbui-widget-metric{border:1px solid rgba(148,163,184,.28);border-radius:6px;padding:5px 6px;min-width:0;background:rgba(148,163,184,.08)}
.bbui-widget-metric span{display:block;color:var(--gray-500,#8b98a7);font-size:10px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bbui-widget-metric b{display:block;font-size:16px;line-height:1.05;color:var(--gray-900,#d8dee9)}
.bbui-widget-metric.ok b,.bbui-widget-state.ok h4,.bbui-widget-pill.ok{color:#7bbf59}
.bbui-widget-metric.warn b,.bbui-widget-state.warn h4,.bbui-widget-pill.warn{color:#d5a11e}
.bbui-widget-metric.err b,.bbui-widget-state.err h4,.bbui-widget-pill.err{color:#d95c59}
.bbui-widget-metric.run b,.bbui-widget-state.run h4,.bbui-widget-pill.run{color:#5d9cec}
.bbui-widget-main{border:1px solid rgba(148,163,184,.28);border-radius:7px;padding:7px;margin-bottom:6px;background:rgba(148,163,184,.06)}
.bbui-widget-main-row{display:flex;align-items:center;gap:8px}
.bbui-widget-status{width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center;border:1px solid currentColor;font-weight:900;flex:0 0 auto}
.bbui-widget-state h4{margin:0 0 1px;font-size:12px;font-weight:800}
.bbui-widget-state strong{display:block;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.bbui-widget-state p{margin:1px 0 0;color:var(--gray-500,#8b98a7);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bbui-widget-pill{margin-left:auto;border:1px solid currentColor;border-radius:6px;padding:3px 7px;font-weight:800;white-space:nowrap}
.bbui-widget-split{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:6px}
.bbui-widget-box{border:1px solid rgba(148,163,184,.28);border-radius:7px;padding:7px;background:rgba(148,163,184,.05);min-width:0}
.bbui-widget-box h4{margin:0 0 4px;font-size:12px;font-weight:800;color:#5d9cec}
.bbui-widget-next div{display:flex;justify-content:space-between;gap:8px;color:var(--gray-500,#8b98a7);padding:1px 0}
.bbui-widget-next span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bbui-widget-next b{color:var(--gray-300,#cbd5e1);white-space:nowrap}
.bbui-widget-restore p{margin:0;color:var(--gray-500,#8b98a7);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bbui-widget-footer{display:flex;justify-content:space-between;gap:8px;color:var(--gray-500,#8b98a7);font-size:11px}
.bbui-widget-footer span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bbui-widget-note{border:1px solid rgba(213,161,30,.45);border-radius:6px;padding:5px 7px;margin-bottom:7px;color:#d5a11e;background:rgba(213,161,30,.10)}
@media (max-width:520px){.bbui-widget-strip{grid-template-columns:repeat(3,minmax(0,1fr))}.bbui-widget-split{grid-template-columns:1fr}}
</style>
<div class="bbui-widget">
  <div class="bbui-widget-head">
    <img class="bbui-widget-icon" src="/plugins/borg-backup-ui/app-icon.png" alt="">
    <div>
      <div class="bbui-widget-title">Borg Backup UI</div>
      <div class="bbui-widget-sub">{$job_total} {$job_label}</div>
    </div>
    <div class="bbui-widget-actions">
      <a class="bbui-widget-action" href="#" onclick="location.reload();return false;" title="Aktualisieren">&#8635;</a>
      <a class="bbui-widget-action" href="{$ui_url}" target="_blank" title="Borg Backup UI oeffnen">&#8599;</a>
      <a class="bbui-widget-action" href="/Settings/borg-backup-ui" title="Einstellungen">&#9881;</a>
    </div>
  </div>
  {$cache_note}
  <div class="bbui-widget-strip">
    <div class="bbui-widget-metric ok"><span>Erfolgreich</span><b>{$success}</b></div>
    <div class="bbui-widget-metric warn"><span>Warnungen</span><b>{$warnings}</b></div>
    <div class="bbui-widget-metric err"><span>Fehler</span><b>{$failed}</b></div>
    <div class="bbui-widget-metric run"><span>Laeuft</span><b>{$running}</b></div>
    <div class="bbui-widget-metric"><span>Repos online</span><b>{$repo_online}/{$repo_total}</b></div>
  </div>
  <div class="bbui-widget-main bbui-widget-state {$latest_state}">
    <div class="bbui-widget-main-row">
      <div class="bbui-widget-status">{$latest_icon}</div>
      <div style="min-width:0"><h4>Letztes Backup</h4><strong>{$latest_name_h}</strong><p>{$latest_detail_h}</p></div>
      <div class="bbui-widget-pill {$latest_state}">{$latest_label_h}</div>
    </div>
  </div>
  <div class="bbui-widget-split">
    <div class="bbui-widget-box bbui-widget-next">
      <h4>Naechste Backups</h4>
      {$next_rows}
    </div>
    <div class="bbui-widget-box bbui-widget-restore">
      <h4>Restore-Nachweis</h4>
      <p><strong>{$restore_label_h}</strong></p>
      <p>{$restore_overdue} ueberfaellig &middot; {$restore_failed} Fehler &middot; {$restore_open} offen</p>
    </div>
  </div>
  <div class="bbui-widget-footer"><span>Status: {$overall_label_h}</span><span>Aktualisiert: {$generated_h}</span></div>
</div>
</td></tr>
</tbody>
EOT;
?>
