<script>
(function(){
  const root = document.getElementById('bbui-widget');
  if (!root) return;
  const endpoint = root.getAttribute('data-endpoint');
  const tile = root.closest('tbody') || document;
  const body = tile.querySelector('[data-bbui-body]');
  const refreshButton = tile.querySelector('[data-bbui-refresh]');
  const collapseButton = tile.querySelector('[data-bbui-collapse]');
  const fields = {};
  tile.querySelectorAll('.bbui-tile-title [data-bbui], #bbui-widget [data-bbui]').forEach((node) => fields[node.getAttribute('data-bbui')] = node);
  const latestState = root.querySelector('[data-bbui-latest-state]');
  const latestPill = root.querySelector('[data-bbui-latest-pill]');
  const overallDot = root.querySelector('[data-bbui-overall-dot]');

  function get(data, path, fallback) {
    return path.split('.').reduce((value, part) => value && Object.prototype.hasOwnProperty.call(value, part) ? value[part] : undefined, data) ?? fallback;
  }
  function intValue(data, path) {
    const value = parseInt(get(data, path, 0), 10);
    return Number.isFinite(value) && value > 0 ? value : 0;
  }
  function stateClass(value) {
    value = String(value || '').toLowerCase();
    if (['ok','healthy','success'].includes(value)) return 'ok';
    if (['warning','attention'].includes(value)) return 'warn';
    if (['error','critical','failed'].includes(value)) return 'err';
    if (['running','active'].includes(value)) return 'run';
    return 'neutral';
  }
  function statusLabel(value) {
    const state = stateClass(value);
    if (state === 'ok') return 'OK';
    if (state === 'warn') return 'Warning';
    if (state === 'err') return 'Failed';
    if (state === 'run') return 'Running';
    return '-';
  }
  function latestIcon(value) {
    const state = stateClass(value);
    if (state === 'ok') return 'fa-check-circle-o';
    if (state === 'warn') return 'fa-exclamation-triangle';
    if (state === 'err') return 'fa-times-circle-o';
    if (state === 'run') return 'fa-play-circle-o';
    return 'fa-minus';
  }
  function formatTime(value) {
    if (!value) return 'never updated';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);
    return date.toLocaleString('en-US', {month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit'});
  }
  function parseDateValue(value) {
    const raw = String(value || '').trim();
    if (!raw) return null;
    const normalized = raw.includes('T') ? raw : raw.replace(' ', 'T');
    const date = new Date(normalized);
    return Number.isNaN(date.getTime()) ? null : date;
  }
  function isPast(value, now) {
    const date = parseDateValue(value);
    return !!date && date.getTime() <= now.getTime();
  }
  function adjustedJobCounts(data, now) {
    const items = Array.isArray(get(data, 'jobs.items', [])) ? get(data, 'jobs.items', []) : [];
    if (!items.length) {
      return {
        total: intValue(data, 'jobs.enabled'),
        successful: intValue(data, 'jobs.successful'),
        warnings: intValue(data, 'jobs.warnings'),
        failed: intValue(data, 'jobs.failed'),
        running: intValue(data, 'jobs.running')
      };
    }
    const counts = {total: 0, successful: 0, warnings: 0, failed: 0, running: 0};
    items.forEach((item) => {
      if (!item || item.enabled === false) return;
      counts.total += 1;
      if (item.running) {
        counts.running += 1;
        return;
      }
      const status = String(item.last_status || '').toLowerCase();
      const overdue = !!item.backup_overdue || isPast(item.backup_overdue_after, now);
      if (status === 'error' || status === 'failed' || status === 'failure') {
        counts.failed += 1;
      } else if (overdue || ['warning','cancelled','skipped'].includes(status)) {
        counts.warnings += 1;
      } else if (status === 'success') {
        counts.successful += 1;
      }
    });
    return counts;
  }
  function adjustedRestoreProof(data, now) {
    const items = Array.isArray(get(data, 'jobs.items', [])) ? get(data, 'jobs.items', []) : [];
    if (!items.length) {
      return {
        configured: intValue(data, 'restore_proof.configured'),
        verified: intValue(data, 'restore_proof.verified'),
        failed: intValue(data, 'restore_proof.failed'),
        overdue: intValue(data, 'restore_proof.overdue'),
        open: intValue(data, 'restore_proof.open')
      };
    }
    const proof = {configured: 0, verified: 0, failed: 0, overdue: 0, open: 0};
    items.forEach((item) => {
      if (!item || item.enabled === false) return;
      const status = String(item.restore_verification_status || 'never').toLowerCase();
      if (status === 'not_required') return;
      proof.configured += 1;
      if (status === 'verified') proof.verified += 1;
      else if (status === 'failed') proof.failed += 1;
      else if (status === 'never' || status === '') proof.open += 1;
      if (status === 'stale' || !!item.restore_verification_is_overdue || isPast(item.restore_verification_valid_until, now)) {
        proof.overdue += 1;
      }
    });
    return proof;
  }
  function overallStateFromCounts(counts, restore) {
    if (counts.failed || restore.failed) return 'error';
    if (counts.warnings || restore.overdue) return 'warning';
    if (counts.running) return 'running';
    if (!counts.total) return 'unknown';
    return 'ok';
  }
  function setText(name, value) {
    if (fields[name]) fields[name].textContent = String(value);
  }
  function setIcon(name, iconClass) {
    if (fields[name]) fields[name].innerHTML = '<i class="fa ' + iconClass + '"></i>';
  }
  function setLatestClass(cls) {
    ['ok','warn','err','run','neutral'].forEach((name) => {
      latestState && latestState.classList.remove(name);
      latestPill && latestPill.classList.remove(name);
    });
    latestState && latestState.classList.add(cls);
    latestPill && latestPill.classList.add(cls);
  }
  function setOverallClass(cls) {
    ['ok','warn','err','run','neutral'].forEach((name) => overallDot && overallDot.classList.remove(name));
    overallDot && overallDot.classList.add(cls);
  }
  function render(data) {
    const now = new Date();
    const counts = adjustedJobCounts(data, now);
    const restore = adjustedRestoreProof(data, now);
    const total = counts.total;
    const repoOnline = intValue(data, 'repositories.online');
    const repoTotal = intValue(data, 'repositories.total');
    const latestStatus = get(data, 'latest_backup.status', 'unknown');
    const latestCls = stateClass(latestStatus);
    const overallState = overallStateFromCounts(counts, restore);
    const overallCls = stateClass(overallState);
    const configured = restore.configured;
    const cacheState = String(get(data, 'cache_state', 'missing'));
    const cacheNote = cacheState === 'initial' ? 'Initial status' : '';
    let latestName = String(get(data, 'latest_backup.name', '') || '').trim();
    let latestDetail = String(get(data, 'latest_backup.detail', '') || '').trim();
    if (!latestName) latestName = 'No status yet';
    if (!latestDetail) latestDetail = 'Cached status updates after backup or restore-test activity.';

    setText('job_total', total);
    setText('job_label', total === 1 ? 'backup job' : 'backup jobs');
    setText('cache_note', cacheNote);
    setText('success', counts.successful);
    setText('warnings', counts.warnings);
    setText('failed', counts.failed);
    setText('running', counts.running);
    setText('repos', repoOnline + '/' + repoTotal);
    setIcon('latest_icon', latestIcon(latestStatus));
    setText('latest_name', latestName);
    setText('latest_detail', latestDetail);
    setText('latest_label', statusLabel(latestStatus));
    setText('restore_label', configured < 1 ? 'not planned' : restore.verified + '/' + configured + ' verified');
    setText('restore_detail', restore.overdue + ' overdue - ' + restore.failed + ' failed - ' + restore.open + ' open');
    setText('overall_label', statusLabel(overallState));
    setText('generated', formatTime(get(data, 'generated_at', '')));
    setLatestClass(latestCls);
    setOverallClass(overallCls);

    const nextRows = Array.isArray(data.next_backups) ? data.next_backups.slice(0, 2) : [];
    if (fields.next_rows) {
      fields.next_rows.textContent = '';
      if (!nextRows.length) {
        const row = document.createElement('div');
        row.innerHTML = '<span>No scheduled backups</span><b>-</b>';
        fields.next_rows.appendChild(row);
      } else {
        nextRows.forEach((item) => {
          const row = document.createElement('div');
          const name = document.createElement('span');
          const time = document.createElement('b');
          name.textContent = item && item.name ? item.name : 'Backup';
          time.textContent = item && item.time ? item.time : '';
          row.appendChild(name);
          row.appendChild(time);
          fields.next_rows.appendChild(row);
        });
      }
    }
  }
  async function update() {
    try {
      const response = await fetch(endpoint + '?_=' + Date.now(), {cache: 'no-store'});
      if (!response.ok) throw new Error('status ' + response.status);
      const data = await response.json();
      render(data);
    } catch (_error) {
      setText('cache_note', 'Status cache is not reachable');
    }
  }
  try {
    const initial = JSON.parse(document.getElementById('bbui-widget-initial').textContent || '{}');
    render(initial);
  } catch (_error) {}
  refreshButton && refreshButton.addEventListener('click', function(event) {
    event.preventDefault();
    update();
  });
  collapseButton && collapseButton.addEventListener('click', function(event) {
    event.preventDefault();
    if (!body) return;
    const hidden = body.style.display === 'none';
    body.style.display = hidden ? '' : 'none';
    const icon = collapseButton.querySelector('i');
    if (icon) {
      icon.className = hidden ? 'fa fa-chevron-up' : 'fa fa-chevron-down';
    }
  });
  window.setInterval(update, 15000);
  update();
})();
</script>
</td></tr>
</tbody>
EOT;
?>
