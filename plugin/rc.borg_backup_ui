#!/bin/bash
# rc.borg_backup_ui - Start/stop script for Unraid.
# Started by the Unraid plugin flow and the control page.

PLUGIN_DIR="/boot/config/plugins/borg-backup-ui"
PIDFILE="/var/run/borg_backup_ui.pid"
WAIT_PIDFILE="/var/run/borg_backup_ui_start_wait.pid"
LOGFILE="/var/log/borg_backup_ui.log"
BORG_BUNDLE_DIR="${PLUGIN_DIR}/runtime/bin/borg"
BORG_BUNDLE_VERSIONED="${BORG_BUNDLE_DIR}/borg-linux-glibc231-x86_64-1.4.5"
BORG_BUNDLE_PLAIN="${BORG_BUNDLE_DIR}/borg"
BORG_STAGE_BIN="/usr/local/bin/borg"
BORG_LINK_BIN="/usr/bin/borg"
MIN_PYTHON_MAJOR=3
MIN_PYTHON_MINOR=10
PYTHON_WAIT_SECONDS="${PYTHON_WAIT_SECONDS:-300}"
PYTHON_WAIT_STEP_SECONDS="${PYTHON_WAIT_STEP_SECONDS:-3}"

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

python_runtime_status() {
  waited=0
  logged_wait=0
  PY_BIN="$(command -v python3 || true)"
  while [ -z "$PY_BIN" ] && [ "$waited" -lt "$PYTHON_WAIT_SECONDS" ]; do
    if [ "$logged_wait" -eq 0 ]; then
      echo "Python runtime is not available yet, waiting up to ${PYTHON_WAIT_SECONDS}s for Unraid plugin initialization..." >> "$LOGFILE"
      logged_wait=1
    fi
    sleep "$PYTHON_WAIT_STEP_SECONDS"
    waited=$((waited + PYTHON_WAIT_STEP_SECONDS))
    PY_BIN="$(command -v python3 || true)"
  done
  if [ -z "$PY_BIN" ]; then
    echo "ERROR: python3 was not found after ${PYTHON_WAIT_SECONDS}s. Install the 'Python 3 for Unraid' plugin or check the boot order." >> "$LOGFILE"
    return 1
  fi
  if [ "$waited" -gt 0 ]; then
    echo "Python runtime became available after ${waited}s: ${PY_BIN}" >> "$LOGFILE"
  fi
  if [ ! -x "$PY_BIN" ]; then
    echo "ERROR: python3 is not executable: $PY_BIN" >> "$LOGFILE"
    return 1
  fi
  PY_VERSION="$("$PY_BIN" -c 'import sys; print(".".join(map(str, sys.version_info[:3]))); raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null)"
  PY_RC=$?
  if [ "$PY_RC" -ne 0 ]; then
    echo "ERROR: Python ${PY_VERSION:-unknown} is too old. Python ${MIN_PYTHON_MAJOR}.${MIN_PYTHON_MINOR} or newer is required. Please update the 'Python 3 for Unraid' plugin." >> "$LOGFILE"
    return 1
  fi
  echo "$PY_BIN"
  return 0
}

defer_start_until_python_ready() {
  if [ -f "$WAIT_PIDFILE" ] && kill -0 "$(cat "$WAIT_PIDFILE")" 2>/dev/null; then
    echo "Borg Backup UI is already waiting for the Python runtime in the background (PID: $(cat "$WAIT_PIDFILE"))"
    return 0
  fi
  echo "Python runtime is not available yet, starting Borg Backup UI background wait process (up to ${PYTHON_WAIT_SECONDS}s)." >> "$LOGFILE"
  BBUI_DEFERRED_START=1 "$0" start >> "$LOGFILE" 2>&1 &
  echo $! > "$WAIT_PIDFILE"
  echo "Borg Backup UI wait process started (PID: $!)"
  return 0
}

start() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "Borg Backup UI is already running (PID: $(cat "$PIDFILE"))"
    return 0
  fi
  if [ "${BBUI_DEFERRED_START:-0}" != "1" ] && [ -f "$WAIT_PIDFILE" ] && kill -0 "$(cat "$WAIT_PIDFILE")" 2>/dev/null; then
    echo "Borg Backup UI is already waiting for the Python runtime in the background (PID: $(cat "$WAIT_PIDFILE"))"
    return 0
  fi

  if [ ! -f "${PLUGIN_DIR}/borg_backup_ui.py" ]; then
    echo "ERROR: ${PLUGIN_DIR}/borg_backup_ui.py not found" >&2
    return 1
  fi

  if [ "${BBUI_DEFERRED_START:-0}" != "1" ] && ! command -v python3 >/dev/null 2>&1; then
    defer_start_until_python_ready
    return 0
  fi

  # Prefer bundled Borg binary when available (no symlink requirement on flash FS).
  if [ -f "${BORG_BUNDLE_VERSIONED}" ]; then
    chmod +x "${BORG_BUNDLE_VERSIONED}" 2>/dev/null || true
  fi
  if [ -f "${BORG_BUNDLE_PLAIN}" ]; then
    chmod +x "${BORG_BUNDLE_PLAIN}" 2>/dev/null || true
  fi

  BORG_BIN=""
  if [ -x "${BORG_BUNDLE_PLAIN}" ]; then
    BORG_BIN="${BORG_BUNDLE_PLAIN}"
  elif [ -x "${BORG_BUNDLE_VERSIONED}" ]; then
    BORG_BIN="${BORG_BUNDLE_VERSIONED}"
  elif [ -f "${BORG_BUNDLE_PLAIN}" ]; then
    cp -f "${BORG_BUNDLE_PLAIN}" "${BORG_STAGE_BIN}" 2>/dev/null || true
    chmod 755 "${BORG_STAGE_BIN}" 2>/dev/null || true
    [ -x "${BORG_STAGE_BIN}" ] && BORG_BIN="${BORG_STAGE_BIN}"
  elif [ -f "${BORG_BUNDLE_VERSIONED}" ]; then
    cp -f "${BORG_BUNDLE_VERSIONED}" "${BORG_STAGE_BIN}" 2>/dev/null || true
    chmod 755 "${BORG_STAGE_BIN}" 2>/dev/null || true
    [ -x "${BORG_STAGE_BIN}" ] && BORG_BIN="${BORG_STAGE_BIN}"
  fi

  if [ -n "${BORG_BIN}" ]; then
    # Ensure command name "borg" exists in /usr/local/bin even when bundle file is versioned.
    if [ "${BORG_BIN}" != "${BORG_STAGE_BIN}" ]; then
      cp -f "${BORG_BIN}" "${BORG_STAGE_BIN}" 2>/dev/null || true
      chmod 755 "${BORG_STAGE_BIN}" 2>/dev/null || true
      [ -x "${BORG_STAGE_BIN}" ] && BORG_BIN="${BORG_STAGE_BIN}"
    fi
    export PATH="/usr/local/bin:${BORG_BUNDLE_DIR}:$PATH"
    # Make borg callable in interactive shells, also repair broken /usr/bin/borg links.
    if [ -L "${BORG_LINK_BIN}" ] && [ ! -e "${BORG_LINK_BIN}" ]; then
      rm -f "${BORG_LINK_BIN}" 2>/dev/null || true
    fi
    if [ -x "${BORG_STAGE_BIN}" ] && [ -w "/usr/bin" ]; then
      ln -sfn "${BORG_STAGE_BIN}" "${BORG_LINK_BIN}" 2>/dev/null || true
      if [ ! -x "${BORG_LINK_BIN}" ]; then
        cp -f "${BORG_STAGE_BIN}" "${BORG_LINK_BIN}" 2>/dev/null || true
        chmod 755 "${BORG_LINK_BIN}" 2>/dev/null || true
      fi
    fi
    echo "Borg Binary: ${BORG_BIN}"
  else
    echo "WARNING: bundled Borg binary not found, using system PATH."
  fi
  echo "Starting Borg Backup UI..."
  PY_BIN="$(python_runtime_status)"
  if [ -z "$PY_BIN" ]; then
    [ "${BBUI_DEFERRED_START:-0}" = "1" ] && rm -f "$WAIT_PIDFILE"
    return 1
  fi
  echo "Python Runtime: ${PY_BIN}" >> "$LOGFILE"
  "$PY_BIN" "${PLUGIN_DIR}/borg_backup_ui.py" >> "$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  [ "${BBUI_DEFERRED_START:-0}" = "1" ] && rm -f "$WAIT_PIDFILE"
  echo "Borg Backup UI started (PID: $!)"
}

stop() {
  if [ -f "$WAIT_PIDFILE" ]; then
    WAIT_PID=$(cat "$WAIT_PIDFILE")
    if kill -0 "$WAIT_PID" 2>/dev/null; then
      kill "$WAIT_PID" 2>/dev/null || true
      echo "Borg Backup UI wait process stopped"
    fi
    rm -f "$WAIT_PIDFILE"
  fi
  if [ -f "$PIDFILE" ]; then
    PID=$(cat "$PIDFILE")
    if kill -0 "$PID" 2>/dev/null; then
      kill "$PID"
      sleep 1
      kill -0 "$PID" 2>/dev/null && kill -9 "$PID" 2>/dev/null
      echo "Borg Backup UI stopped"
    else
      echo "Borg Backup UI is not running"
    fi
    rm -f "$PIDFILE"
  else
    echo "Borg Backup UI is not running"
  fi
}

status() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "Borg Backup UI is running (PID: $(cat "$PIDFILE"))"
  elif [ -f "$WAIT_PIDFILE" ] && kill -0 "$(cat "$WAIT_PIDFILE")" 2>/dev/null; then
    echo "Borg Backup UI is waiting for the Python runtime (PID: $(cat "$WAIT_PIDFILE"))"
  else
    echo "Borg Backup UI is not running"
  fi
}

case "$1" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 1; start ;;
  status)  status ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
