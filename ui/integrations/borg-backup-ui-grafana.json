      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "bbui_backup_last_duration_seconds{instance=~\"$instance\",location=~\"$location\",repository=~\"$repository\",job_name=~\"$backup_job\"}",
          "legendFormat": "{{job_name}} / {{location}} / {{instance}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
