        "textMode": "auto"
      }
    },
    {
      "id": 10,
      "title": "Restore verification",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "description": "verified: current evidence; stale: expired; failed: last verification failed; never: no test; not_required: disabled. Test levels do not prove application-level recovery.",
      "targets": [
        {
          "refId": "A",
          "expr": "bbui_restore_verification_state{instance=~\"$instance\",location=~\"$location\",repository=~\"$repository\",job_name=~\"$backup_job\"} == 1",
          "legendFormat": "{{job_name}} / {{location}} / {{instance}} / {{state}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
