      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "description": "1 = overdue, 0 = current. Uses the plugin reminder policy. No data when there is no schedule or no usable status evidence.",
      "targets": [
        {
          "refId": "A",
          "expr": "bbui_backup_overdue{instance=~\"$instance\",location=~\"$location\",repository=~\"$repository\",job_name=~\"$backup_job\"}",
