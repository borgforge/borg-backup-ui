          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Time since last successful backup",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "description": "Based on successes retained in plugin status history. Missing evidence is not zero.",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - bbui_backup_last_success_timestamp_seconds{instance=~\"$instance\",location=~\"$location\",repository=~\"$repository\",job_name=~\"$backup_job\"}",
          "legendFormat": "{{job_name}} / {{location}} / {{instance}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
