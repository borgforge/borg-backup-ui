      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "description": "Configured calendar occurrence. Busy repositories or unavailable storage can cause a run to be skipped.",
      "targets": [
        {
          "refId": "A",
          "expr": "bbui_restore_test_next_run_timestamp_seconds{instance=~\"$instance\",location=~\"$location\",repository=~\"$repository\",job_name=~\"$backup_job\"} * 1000",
