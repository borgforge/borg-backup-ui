      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "description": "Statistics of the latest recorded success/warning with an archive. Deduplicated bytes describe newly stored data for that archive.",
      "targets": [
        {
          "refId": "A",
          "expr": "bbui_backup_archive_original_bytes{instance=~\"$instance\",location=~\"$location\",repository=~\"$repository\",job_name=~\"$backup_job\"}",
          "legendFormat": "{{job_name}} / {{location}} / {{instance}} / original",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "bbui_backup_archive_compressed_bytes{instance=~\"$instance\",location=~\"$location\",repository=~\"$repository\",job_name=~\"$backup_job\"}",
          "legendFormat": "{{job_name}} / {{location}} / {{instance}} / compressed",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "C",
          "expr": "bbui_backup_archive_deduplicated_bytes{instance=~\"$instance\",location=~\"$location\",repository=~\"$repository\",job_name=~\"$backup_job\"}",
          "legendFormat": "{{job_name}} / {{location}} / {{instance}} / deduplicated",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
